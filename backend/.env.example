# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://sitepilot:sitepilot@localhost:5432/sitepilot

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Kubernetes (set when running inside cluster)
K8S_NAMESPACE=tenants
K8S_IN_CLUSTER=false
KUBECONFIG=/root/.kube/config

# Docker registry
REGISTRY_URL=localhost:5000

# Jenkins
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=changeme

# Repos storage path (tenant bare git repos)
REPOS_BASE_PATH=/data/repos
