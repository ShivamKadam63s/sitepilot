apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ site_slug }}
  namespace: {{ namespace }}
  labels:
    app: {{ site_slug }}
    managed-by: sitepilot
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ site_slug }}
  minReplicas: 1
  maxReplicas: 5
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 80
